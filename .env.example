# Copy this file to ".env" and add your own Google Gemini API key.
# Get a key at https://aistudio.google.com/apikey
#
# Without a key the notebook still runs every offline step (EDA, BiLSTM
# training, the four-model retrieval comparison). Only the Gemini Only and
# Hybrid systems - and therefore the response-quality and hallucination
# sections - need the key.
GOOGLE_API_KEY=your_gemini_api_key_here
